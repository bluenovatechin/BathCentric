# Copy to .env for local builds, and add the same names as GitHub repository variables
# (Settings → Secrets and variables → Actions → Variables) for the automatic deploy.
# These values are public (they appear in the website). Never put a password or secret key here.

# Where the site lives (GitHub Pages now; change both when you move to your own domain)
BASE_PATH=/BathCentric/
VITE_SITE_URL=https://bluenovatechin.github.io/BathCentric

# WhatsApp number that receives quote requests and messages: country code + number, digits only.
# Leave empty to use the built-in number (+91 98765 43210, set in src/config.js).
VITE_WHATSAPP=
# Phone shown on the site; empty = the WhatsApp number above
VITE_PHONE=
VITE_EMAIL=
VITE_ADDRESS=
VITE_SERVICE_AREA=
VITE_HOURS=

# Google Analytics 4 id (loads only after cookie consent) and the Search Console HTML-tag value
VITE_GA_ID=
VITE_GOOGLE_SITE_VERIFICATION=
