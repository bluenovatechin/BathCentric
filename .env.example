# Copy to .env (local) or add these in your host's environment settings.
# Everything prefixed VITE_ is bundled into the public website, so ONLY put public values there.
# Secret keys (RESEND_API_KEY, TURNSTILE_SECRET_KEY) are server-side only and are read by api/lead.js on Vercel.

# --- Where the site lives -------------------------------------------------
# GitHub Pages today:
BASE_PATH=/BathCentric/
VITE_SITE_URL=https://bluenovatechin.github.io/BathCentric
# After moving to Vercel + your domain, change to:
# BASE_PATH=/
# VITE_SITE_URL=https://bathcentric.in

# --- Business details (shown on the site) --------------------------------
VITE_PHONE_DISPLAY=+91 98765 43210
VITE_PHONE_E164=+919876543210
VITE_WHATSAPP_NUMBER=919876543210
VITE_EMAIL=enquiries@bathcentric.in
# e.g. "Mumbai, Thane and Navi Mumbai". Leave empty to hide.
VITE_SERVICE_AREA=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=

# --- Enquiry delivery -----------------------------------------------------
# GitHub Pages: create a free access key at https://web3forms.com (it emails leads to your inbox).
# Web3Forms access keys are public by design: they can only send to the inbox they were created for.
VITE_FORM_PROVIDER=web3forms
VITE_WEB3FORMS_KEY=
# Vercel: switch to the built-in serverless function (supports photo attachments):
# VITE_FORM_PROVIDER=api
# VITE_LEAD_API=/api/lead

# --- Bot protection (optional, recommended on Vercel) ----------------------
# Cloudflare Turnstile site key (public). Pair with TURNSTILE_SECRET_KEY on the server.
VITE_TURNSTILE_SITE_KEY=

# --- Analytics & Search Console --------------------------------------------
# GA4 measurement id, loaded only after cookie consent.
VITE_GA_ID=
# Content of Google Search Console's HTML-tag verification (just the content="..." value).
VITE_GOOGLE_SITE_VERIFICATION=

# --- Server-side only (Vercel → Settings → Environment Variables). Never prefix with VITE_. ---
# RESEND_API_KEY=
# LEAD_TO_EMAIL=enquiries@bathcentric.in
# LEAD_FROM_EMAIL=BathCentric Website <leads@bathcentric.in>
# TURNSTILE_SECRET_KEY=
